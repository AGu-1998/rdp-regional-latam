
      - name: 1. Detectar y validar region
        id: region
        shell: bash
        run: |
          set -euo pipefail

          GEO="$(curl -4fsS --max-time 20 https://ipinfo.io/json)"

          COUNTRY="$(echo "$GEO" | jq -r '.country // "UNKNOWN"')"
          CITY="$(echo "$GEO" | jq -r '.city // "desconocida"')"
          REGION="$(echo "$GEO" | jq -r '.region // "desconocida"')"

          echo "Pais: $COUNTRY"
          echo "Ciudad: $CITY"
          echo "Region: $REGION"

          echo "country=$COUNTRY" >> "$GITHUB_OUTPUT"

          case "$COUNTRY" in
            BR)
              echo "BRASIL DETECTADO: prioridad maxima."
              ;;
            AR|BO|BZ|CL|CO|CR|CU|DO|EC|SV|GT|HN|HT|JM|MX|NI|PA|PE|PR|PY|TT|UY|VE)
              echo "LATINOAMERICA DETECTADA."
              ;;
            *)
              echo "::error::Servidor fuera de Latinoamerica: $COUNTRY"
              echo "No se instalaran escritorio ni XRDP."
              exit 1
              ;;
          esac
